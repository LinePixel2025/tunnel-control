# Generate with: openssl rand -hex 32
BOOTSTRAP_AGENT_TOKEN=replace-with-a-long-random-agent-token
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret
# Admin panel login stays valid for this many hours. Default: 720 (30 days).
ADMIN_TOKEN_TTL_HOURS=720
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-on-first-start
# Choose a TCP port available in your cloud security group/firewall.
CONTROL_PORT=18080
# UDP sessions idle timeout in seconds (minimum 30, default 120).
UDP_SESSION_IDLE_SECS=120
# Server-wide bandwidth cap in Mbps; 0 disables throttling. When the cap is
# reached, every tunnel slows down fairly instead of dropping connections.
BANDWIDTH_LIMIT_MBPS=0
