FROM rust:1.97-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
RUN cargo build --release -p tunnel-server

FROM alpine:3.21
RUN addgroup -S tunnel && adduser -S tunnel -G tunnel
COPY --from=build /src/target/release/tunnel-server /usr/local/bin/tunnel-server
USER tunnel
EXPOSE 18080
ENTRYPOINT ["tunnel-server"]
