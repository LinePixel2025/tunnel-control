# Public management panel and WebSocket control endpoint.
CONTROL_PORT=18080

# Public TCP/HTTP tunnel port range. Keep this range small at first.
TUNNEL_PORT_START=10000
TUNNEL_PORT_END=10100

# Data channels per agent. The agent opens this many data WebSockets after
# registration; a data-channel flap only affects the streams on that channel.
DATA_CHANNELS_MAX=4

# Seconds to drain in-flight streams after SIGTERM/Ctrl-C before exit.
SHUTDOWN_DRAIN_SECS=10

# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Admin panel login stays valid for this many hours. Default: 720 (30 days).
ADMIN_TOKEN_TTL_HOURS=720
BOOTSTRAP_AGENT_TOKEN=replace-with-an-initial-agent-token
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-first-login-password

# Existing 1Panel deployment volumes. Leave unchanged when upgrading this project.
POSTGRES_VOLUME_NAME=tunnel-control_tunnel-control-postgres-data
REDIS_VOLUME_NAME=tunnel-control_tunnel-control-redis-data

# --- Windows agent (tunnel-agent.exe) environment variables ---
# Agent-side equivalents: DATA_CHANNELS (1-8, default 2), heartbeat and pong
# timing (seconds), and reconnect backoff bounds (seconds). Set these in the
# service environment or agent.env next to the binary.
# DATA_CHANNELS=2
# AGENT_HEARTBEAT_SECS=10
# AGENT_PONG_TIMEOUT_SECS=25
# AGENT_RECONNECT_MIN_SECS=1
# AGENT_RECONNECT_MAX_SECS=10
